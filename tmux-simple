#!/usr/bin/env python3
"""Opt-in, single-pane tmux with ordinary Mosh and non-modal history browsing."""

import argparse
import fcntl
import os
import re
import shlex
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path

import tmux_clients

ROOT = Path(__file__).resolve().parent
VERSION = "tmux 3.7c-simple1"


def arguments():
    parser = argparse.ArgumentParser(
        description="Persistent sessions with stock Mosh and simplified tmux controls.",
        epilog="Separate sessions; never loads ~/.tmux.conf or migrates running programs.",
    )
    parser.add_argument("--version", action="version", version="tmux-simple 0.1.0")
    base = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir())
    parser.add_argument(
        "--socket", type=Path, default=base / f"tmux-simple-{os.getuid()}/server.sock"
    )
    parser.add_argument("--tmux", type=Path, default=ROOT / "build/runtime/tmux")
    commands = parser.add_subparsers(dest="action", required=True)
    attach = commands.add_parser(
        "attach", help="create or attach without disconnecting other viewers"
    )
    attach.add_argument("name")
    attach.add_argument(
        "--existing", action="store_true", help="do not create a missing session"
    )
    new = commands.add_parser(
        "new-session",
        aliases=["new"],
        help="compatible new-session [-A] -s NAME syntax",
    )
    new.add_argument(
        "-A", dest="attach_if_exists", action="store_true", help="attach if NAME exists"
    )
    new.add_argument("-s", dest="name", required=True, metavar="NAME")
    new.add_argument("program", nargs=argparse.REMAINDER, metavar="PROGRAM")
    commands.add_parser("list", help="list only tmux-simple sessions")
    clients = commands.add_parser(
        "clients", help="show attachment transport, state and sizing"
    )
    clients.add_argument(
        "--json", action="store_true", help="machine-readable client inventory"
    )
    clients.add_argument(
        "--manage-sizing",
        action="store_true",
        help="compatibility option; Mosh-aware sizing is now automatic",
    )
    detach = commands.add_parser(
        "detach", help="disconnect viewers, leaving their program running"
    )
    detach.add_argument("name")
    kill = commands.add_parser("kill", help="end a named session and its program")
    kill.add_argument("name")
    kill.add_argument("--yes", action="store_true", help="required confirmation")
    argv = sys.argv[1:]
    program = []
    separator = "--" in argv
    if separator:
        split = argv.index("--")
        argv, program = argv[:split], argv[split + 1 :]
    args = parser.parse_args(argv)
    args.compat_new = args.action in ("new-session", "new")
    args.create_only = args.compat_new and not args.attach_if_exists
    if args.compat_new:
        # Native syntax permits a program without --. Once it has started,
        # any later -- belongs to that program and must remain in its argv.
        if args.program:
            program = args.program + (["--", *program] if separator else [])
        args.action = "attach"
        args.existing = False
    if separator and not program:
        parser.error("expected a program after --")
    if program and args.action != "attach":
        parser.error("a program after -- is only valid with attach")
    if hasattr(args, "name") and not re.fullmatch(
        r"[A-Za-z0-9][A-Za-z0-9_-]{0,63}", args.name
    ):
        parser.error(
            "session name: 1-64 ASCII letters, digits, '_' or '-', starting with a letter/digit"
        )
    if args.action == "kill" and not args.yes:
        parser.error("kill ends the program; add --yes, or use detach instead")
    if args.action == "attach":
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            parser.error("attach requires a terminal; over SSH use ssh -t")
        if os.environ.get("TMUX"):
            parser.error("open a fresh terminal outside tmux; do not nest sessions")
        if args.existing and program:
            parser.error("--existing cannot be combined with a program")
    return args, program


class Error(RuntimeError):
    pass


def configuration():
    home = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    if not home.is_absolute():
        home = Path.home() / ".config"
    config = home / "tmux-simple/tmux.conf"
    if not config.exists() and not config.is_symlink():
        config = ROOT / "tmux-simple.conf"
    if not config.is_file():
        raise Error(f"configuration is missing or not a regular file: {config}")
    return config


def main():
    args, program = arguments()
    binary = str(args.tmux.absolute())
    socket = args.socket.absolute()
    if len(os.fsencode(socket)) > 100:
        raise Error("socket path exceeds 100 bytes")
    env = os.environ.copy()
    for key in ("TMUX", "TMUX_PANE", "TMUX_TMPDIR"):
        env.pop(key, None)
    env["TMUX_SIMPLE_ROOT"] = str(ROOT)
    version = subprocess.run(
        [binary, "-V"], capture_output=True, env=env, timeout=5, check=True
    )
    if version.stdout.decode().strip() != VERSION:
        raise Error(
            "requires the separate tmux 3.7c-simple1 build; run scripts/build.sh"
        )

    def run(*argv, check=True):
        # tmux treats a final semicolon as a separator even in an argv element.
        argv = [arg[:-1] + r"\;" if arg.endswith(";") else arg for arg in argv]
        result = subprocess.run(
            [binary, "-S", str(socket), *argv],
            capture_output=True,
            stdin=subprocess.DEVNULL,
            env=env,
            timeout=15,
        )
        if check and result.returncode:
            raise Error(
                result.stderr.decode(errors="replace").strip() or "tmux command failed"
            )
        return result

    socket.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = socket.parent.lstat()
    if (
        not stat.S_ISDIR(info.st_mode)
        or info.st_uid != os.getuid()
        or info.st_mode & 0o077
    ):
        raise Error("socket directory must be yours, not a symlink, and mode 0700")
    lock = os.open(
        socket.with_suffix(".lock"),
        os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o600,
    )
    try:
        info = os.fstat(lock)
        if (
            info.st_uid != os.getuid()
            or not stat.S_ISREG(info.st_mode)
            or info.st_mode & 0o077
        ):
            raise Error("unsafe session lock file")
        deadline = time.monotonic() + 15
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise Error("another attachment is still starting") from None
                time.sleep(0.05)
        alive = run("-N", "show-options", "-s", check=False).returncode == 0
        if (
            alive
            and run(
                "-N", "show-options", "-gv", "@tmux-simple", check=False
            ).stdout.strip()
            != b"1"
        ):
            raise Error("refusing to use a server not created by tmux-simple")
        if alive and args.action in ("clients", "list"):
            try:
                tmux_clients.start_monitor(tmux_clients.Server(binary, socket, env))
            except (
                tmux_clients.MonitorError,
                OSError,
                subprocess.SubprocessError,
            ) as exc:
                print(
                    f"Warning: Mosh sizing monitor unavailable: {exc}", file=sys.stderr
                )
        if args.action == "clients":
            if not alive:
                if args.manage_sizing:
                    raise Error("no tmux-simple server is running")
                print(
                    '{"monitor_running": false, "clients": [], "note": ""}'
                    if args.json
                    else "No tmux-simple clients."
                )
                return 0
            server = tmux_clients.Server(binary, socket, env)
            tmux_clients.show_clients(server, args.json)
            return 0
        if args.action == "list":
            if alive:
                sys.stdout.buffer.write(
                    run(
                        "-N",
                        "list-sessions",
                        "-F",
                        "#{session_name}\t#{session_attached} attached",
                    ).stdout
                )
            else:
                print("No tmux-simple sessions.")
            return 0
        target = "=" + args.name
        exists = (
            alive
            and run("-N", "has-session", "-t", target, check=False).returncode == 0
        )
        if args.action != "attach":
            if not exists:
                raise Error(f"session does not exist: {args.name}")
            if args.action == "detach":
                run("-N", "detach-client", "-s", target)
            else:
                run("-N", "kill-session", "-t", target)
            return 0
        if exists and args.create_only:
            raise Error(f"session already exists: {args.name}; use -A to attach")
        if exists and program and not args.compat_new:
            raise Error("session already exists; omit the program when reattaching")
        if not exists:
            if args.existing:
                raise Error(f"session does not exist: {args.name}")
            size = os.get_terminal_size(0)
            program = program or [os.environ.get("SHELL") or "/bin/sh", "-l"]
            # Keep native single-string shell commands in the compatibility
            # form; simplified attach treats a single argument as an executable.
            if len(program) == 1 and not args.compat_new:
                program = [shlex.quote(program[0])]
            # Configuration belongs to the server, not each new session.
            config_args = [] if alive else ["-f", str(configuration())]
            run(
                *config_args,
                "new-session",
                "-d",
                "-s",
                args.name,
                "-x",
                str(max(2, size.columns)),
                "-y",
                str(max(2, size.lines)),
                "--",
                *program,
            )
        panes = run(
            "-N", "list-panes", "-s", "-t", target, "-F", "#{pane_id}"
        ).stdout.splitlines()
        if len(panes) != 1:
            raise Error("tmux-simple supports one window and pane per session")
        # Do not let a phone attachment unset the desktop's clipboard environment.
        for key in ("WAYLAND_DISPLAY", "DISPLAY"):
            if env.get(key):
                run("-N", "set-environment", "-t", target, key, env[key])
        # Existing servers need this on the new client too, without reloading
        # their configuration or disturbing an already running pane.
        features = (
            ["-T", "hyperlinks"] if env.get("TERM", "").startswith("xterm") else []
        )
        try:
            tmux_clients.maybe_start_monitor(tmux_clients.Server(binary, socket, env))
        except (tmux_clients.MonitorError, OSError, subprocess.SubprocessError) as exc:
            print(f"Warning: Mosh sizing monitor unavailable: {exc}", file=sys.stderr)
        os.execvpe(
            binary,
            [
                binary,
                "-S",
                str(socket),
                *features,
                "attach-session",
                "-E",
                "-t",
                target,
            ],
            env,
        )
    finally:
        os.close(lock)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (
        Error,
        tmux_clients.MonitorError,
        OSError,
        subprocess.SubprocessError,
    ) as exc:
        print(f"tmux-simple: {exc}", file=sys.stderr)
        raise SystemExit(1) from None
