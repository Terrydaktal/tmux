+/* A clipboard write belongs to the most recently active viewer of this pane. */
+static struct client *
+input_clipboard_client(struct input_ctx *ictx)
+{
+	struct client	*c, *best = NULL;
+
+	if (ictx->wp == NULL) {
+		c = ictx->c;
+		if (c != NULL && c->session != NULL &&
+		    options_get_number(c->session->options, "scroll-on-input"))
+			return (c);
+		return (NULL);
+	}
+	TAILQ_FOREACH(c, &clients, entry) {
+		if (c->session == NULL || c->flags &
+		    (CLIENT_UNATTACHEDFLAGS|CLIENT_READONLY|CLIENT_SUSPENDED) ||
+		    server_client_get_pane(c) != ictx->wp ||
+		    !options_get_number(c->session->options, "scroll-on-input"))
+			continue;
+		if (best == NULL || timercmp(&c->activity_time,
+		    &best->activity_time, >))
+			best = c;
+	}
+	return (best);
+}
+
+static u_int input_clipboard_jobs;
+
+static void
+input_clipboard_complete(struct job *job)
+{
+	input_clipboard_jobs--;
+	if (job_get_status(job) != 0)
+		log_debug("%s: copy-command failed", __func__);
+}
+
+/* Use the session's refreshed display environment, not the application's. */
+static void
+input_clipboard_pipe(struct client *c, const void *data, size_t len)
+{
+	const char	*command;
+	struct job	*job;
+
+	command = options_get_string(global_options, "copy-command");
+	/* A noisy application must not create an unbounded number of helpers. */
+	if (*command == '\0' || input_clipboard_jobs >= 8)
+		return;
+	job = job_run(command, 0, NULL, NULL, c->session, NULL, NULL,
+	    input_clipboard_complete, NULL, NULL, JOB_NOWAIT, -1, -1);
+	if (job != NULL) {
+		input_clipboard_jobs++;
+		bufferevent_write(job_get_event(job), data, len);
+	}
+}
+
+/* Decode only one wrapped clipboard write, never a query or other passthrough. */
+static int
+input_dcs_clipboard(struct input_ctx *ictx)
+{
+	const char	 prefix[] = "tmux;\033]52;";
+	const char	*selectors = "cpqs01234567", *base64 =
+	    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=";
+	const char	*p;
+	size_t		 len = ictx->input_len, size = sizeof prefix - 1, i;
+	char		*request;
+	int		 data = 0;
+
+	if (len <= size || memcmp(ictx->input_buf, prefix, size) != 0 ||
+	    input_clipboard_client(ictx) == NULL)
+		return (0);
+	p = ictx->input_buf + size;
+	if (ictx->input_buf[len - 1] == '\007')
+		len--;
+	else if (len >= size + 2 && ictx->input_buf[len - 2] == '\033' &&
+	    ictx->input_buf[len - 1] == '\\')
+		len -= 2;
+	else
+		return (1);
+	for (i = size; i < len; i++) {
+		if (!data && ictx->input_buf[i] == ';') {
+			data = 1;
+			continue;
+		}
+		if (ictx->input_buf[i] == '\0' ||
+		    strchr(data ? base64 : selectors, ictx->input_buf[i]) == NULL)
+			return (1);
+	}
+	if (data) {
+		request = xstrndup(p, len - size);
+		input_osc_52(ictx, request);
+		free(request);
+	}
+	return (1);
+}
