+/* Report the latest-policy owner using the actual sizing calculation. */
+struct client *
+window_size_client(struct window *w)
+{
+	struct client	*c;
+	u_int		 sx, sy, xpixel, ypixel;
+	int		 current;
+
+	if (w->active == NULL ||
+	    options_get_number(w->options, "window-size") != WINDOW_SIZE_LATEST)
+		return (NULL);
+	current = options_get_number(w->options, "aggressive-resize");
+	if (!clients_calculate_size(WINDOW_SIZE_LATEST, current, NULL, NULL, w,
+	    recalculate_size_skip_client, &sx, &sy, &xpixel, &ypixel, &c))
+		return (NULL);
+	return (c);
+}
